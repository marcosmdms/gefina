{
  "name": "gefina",
  "version": "0.0.0",
  "descripotion": "sistema de gestão de contas a receber.",
  "author": "Marcos",
  "scripts": {
    "check": "tsc --noEmit && npx @biomejs/biome check ./",
    "fix": "biome check --write ./",
    "fix:unsafe": "biome check --write --unsafe ./",
    "dev": "node --watch ./server.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15"
  }
}
